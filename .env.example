# CompetitorTrack — environment template
# =============================================================================
# Copy this file to deploy/.env (that is where Docker Compose looks, because the
# compose files live in deploy/) and fill in every value marked CHANGE-ME:
#
#     cp .env.example deploy/.env && chmod 600 deploy/.env
#
# Sections mirror the §A12 table. The [api] section is checked against
# apps/api/app/config.py by `python3 tools/check_env_example.py` — CI fails if a
# variable exists on one side only, in either direction.
#
# Never commit the filled-in file. .gitignore already excludes .env.
# Two of these values cannot be recovered from a database backup: JWT_SECRET
# invalidates every session if lost, and losing MASTER_ENCRYPTION_KEYS makes
# every tenant's stored SMTP password and Gemini key undecryptable forever.
# deploy/scripts/backup.sh therefore backs up this file too, encrypted.
# =============================================================================

# [api]
# Read by BOTH the `api` and `scheduler` services — they run the same image.

# Must name the driver explicitly (psycopg 3). Host `db` is the compose service.
# The user/password/database here must match the [db] section below.
DATABASE_URL=postgresql+psycopg://ct:CHANGE-ME-DB-PASSWORD@db:5432/competitortrack

# CHANGE-ME. At least 32 characters: openssl rand -base64 48
JWT_SECRET=CHANGE-ME-openssl-rand-base64-48
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_GRACE_SECONDS=30

# CHANGE-ME. Comma-separated Fernet keys, newest first (MultiFernet decrypts with
# any, encrypts with the first). Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation procedure: docs/RUNBOOK.md (P6).
MASTER_ENCRYPTION_KEYS=CHANGE-ME-fernet-key

# The single origin the browser talks to. Scheme + host, no path, no trailing
# slash. Also the origin the crawler's User-Agent advertises, and the value the
# CSRF check compares the Origin header against.
PUBLIC_ORIGIN=https://app.jobsearchpk.site
# true everywhere except the local HTTP override; the api refuses false on a
# non-localhost origin rather than shipping session cookies in clear.
COOKIE_SECURE=true

# Platform mailer — auth emails only (verification, reset, invites), never
# digests. Leave empty to have the api log the action links at INFO instead
# (development only). Phase 0 verified Gmail on 587/STARTTLS and 465/SSL from
# the Oracle A1; port 25 is blocked there permanently, which does not matter.
# Gmail needs an App Password (2-Step Verification must be on) — docs/SMTP.md.
# The username's "@" must be percent-encoded as %40, or the URL parses wrongly.
PLATFORM_SMTP_URL=smtp+starttls://CHANGE-ME%40gmail.com:CHANGE-ME-APP-PASSWORD@smtp.gmail.com:587
PLATFORM_FROM_EMAIL=CHANGE-ME@gmail.com

# Scraper. These defaults are the Phase 0 verdict — see docs/PHASE0_FINDINGS.md §6
# before changing any of them.
SCRAPE_INTERVAL_MINUTES=360
MAX_PAGES=4
POLITE_DELAY_SECONDS=2.5
SCRAPER_CONCURRENCY=2
# The honest bot UA (D0.11). {PUBLIC_ORIGIN} is interpolated at startup, so the
# /bot page it advertises is always served by this deployment.
SCRAPER_USER_AGENT=CompetitorTrackBot/1.0 (+{PUBLIC_ORIGIN}/bot)
# Empty = direct egress only, which is what Phase 0 measured: 7/7 stores
# returned 200 directly from the production IP, so no proxy is needed or owned.
SCRAPER_PROXY_URLS=
# off | on_block | always. Empty resolves to on_block when SCRAPER_PROXY_URLS is
# non-empty, otherwise off.
SCRAPER_PROXY_MODE=off

DIGEST_TICK_MINUTES=15
RUN_STALE_MINUTES=30

GEMINI_MODEL=gemini-2.5-flash

# DEBUG | INFO | WARNING | ERROR | CRITICAL. Response bodies are never logged
# above DEBUG.
LOG_LEVEL=INFO

# [db]
# Read by the postgres image on first start. These three MUST agree with
# DATABASE_URL above; changing them after the volume exists does nothing.
POSTGRES_USER=ct
POSTGRES_PASSWORD=CHANGE-ME-DB-PASSWORD
POSTGRES_DB=competitortrack

# [web]
# The Next.js app needs no secrets: it is same-origin with the API and all
# authenticated data is fetched client-side.
NEXT_TELEMETRY_DISABLED=1

# [caddy]
# The domain this deployment answers on. Must have a DNS A record pointing at
# the server's public IP before the first start, or certificate issuance fails
# (docs/DEPLOY.md §2). The local override replaces this with http://localhost.
SERVER_NAME=app.jobsearchpk.site
ACME_EMAIL=CHANGE-ME@gmail.com
# Let's Encrypt allows only 5 duplicate certificates per week, so first-time
# setup and every P1–P5 rebuild use STAGING (the browser will warn — expected).
# Clear this variable to switch to production certificates at go-live (P6).
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# [deploy/backup]
# Host-side only — read by deploy/scripts/*.sh, not by any container.
BACKUP_DIR=/var/backups/competitortrack
# Root-only file holding the passphrase that encrypts the .env copy in each
# backup. Keep the same passphrase in a password manager, offline: without it a
# restored database has undecryptable tenant secrets.
BACKUP_PASSPHRASE_FILE=/root/.ct_backup_passphrase
# Optional off-site copy, e.g. gdrive:competitortrack-backups (Google Drive's
# 15 GB free tier needs no card). Empty = local backups only.
RCLONE_REMOTE=

# [ci]
# GitHub Actions repository secrets — set in the repo settings, never here.
# DEPLOY_SSH_KEY   private key whose public half is in the server's authorized_keys
# DEPLOY_HOST      server hostname or IP
# DEPLOY_USER      SSH user that can run docker compose
